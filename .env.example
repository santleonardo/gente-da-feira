# GDF Chat — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha com seus dados

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# App / URL pública (necessário para dispatch de push)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Segredo interno (Bearer) — rotas /api/push/send, etc. (≥ 32 chars)
# Gerar: openssl rand -hex 32
INTERNAL_API_SECRET=

# Web Push (VAPID)
# Gerar: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:contato@gentedafeira.app
